#!/usr/bin/env bash

set -e

COMMAND="${1:-help}"

case "$COMMAND" in
  update)
    echo "Atualizando o sistema..."
    sudo pacman -Syu
    ;;

  backup)
    echo "Criando backup das configurações..."
    mkdir -p "$HOME/NathanDots/backup"
    cp -a "$HOME/.config/hypr" "$HOME/NathanDots/backup/hypr-$(date +%Y%m%d-%H%M%S)"
    echo "Backup concluído."
    ;;

  restore)
    echo "A restauração ainda será implementada."
    ;;

  wallpaper)
    echo "O seletor de wallpaper ainda será implementado."
    ;;

  theme)
    echo "O seletor de temas ainda será implementado."
    ;;

  doctor)
    echo "Verificando componentes..."
    command -v hyprctl >/dev/null && echo "Hyprland: OK" || echo "Hyprland: ausente"
    command -v waybar >/dev/null && echo "Waybar: OK" || echo "Waybar: ausente"
    command -v kitty >/dev/null && echo "Kitty: OK" || echo "Kitty: ausente"
    ;;

  version)
    echo "NathanDots 0.1.0"
    ;;

  *)
    echo "NathanDots Manager"
    echo
    echo "Uso: nd <comando>"
    echo
    echo "Comandos:"
    echo "  update"
    echo "  backup"
    echo "  restore"
    echo "  wallpaper"
    echo "  theme"
    echo "  doctor"
    echo "  version"
    ;;
esac
